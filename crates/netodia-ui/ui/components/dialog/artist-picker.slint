import { Theme } from "../../theme.slint";
import { ArtistPicker } from "../../globals/artist-picker.slint";
import { Dialog } from "../../globals/dialog.slint";
import { RowCovers } from "../../globals/tracks.slint";
import { ArtworkImage } from "../artwork-image.slint";
import { PickerListCard } from "selectable-picker.slint";

export component ArtistPickerBody inherits PickerListCard {
    row-count: ArtistPicker.rows.length;
    for artist[index] in ArtistPicker.rows: Rectangle {
        height: 60px;
        border-radius: Theme.radius-md;
        background: touch.pressed ? Theme.surface2
            : touch.has-hover ? Theme.surface1 : transparent;
        animate background { duration: Theme.dur-fast; easing: ease-in-out; }
        HorizontalLayout {
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-md;
            spacing: Theme.pad-md;
            alignment: start;
            VerticalLayout {
                alignment: center;
                ArtworkImage {
                    tile-size: 44px;
                    tile-radius: 22px;
                    artwork-path: artist.artwork_path;
                    cover: RowCovers.request(artist.artwork_path, "", "", RowCovers.generation);
                    fallback-icon: "person";
                    cover-scale: touch.pressed ? 0.96 : touch.has-hover ? 1.05 : 1.0;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: artist.name;
                    color: Theme.text;
                    font-size: Theme.font-size-md;
                    overflow: elide;
                }
            }
        }
        touch := TouchArea {
            enabled: Dialog.open;
            mouse-cursor: pointer;
            clicked => {
                Dialog.open = false;
                ArtistPicker.choose(index);
            }
        }
    }
}
