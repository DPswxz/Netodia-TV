import { Theme } from "../../theme.slint";
import { SettingsPage } from "../../globals/settings-page.slint";
import { NetodiaUpdater } from "../../globals/updater.slint";
import { SectionCard } from "../../components/settings/section-card.slint";
import { SectionDivider } from "../../components/settings/section-divider.slint";
import { SettingRow } from "../../components/settings/setting-row.slint";
import { SectionButton } from "../../components/settings/section-button.slint";
import { ProgressBar } from "../../components/settings/progress-bar.slint";
import { ToggleSwitch } from "../../components/settings/toggle-switch.slint";

// The Software Updates row is always drawn; the rest — up-to-date, installed,
// available, error — stack under it on their own mutually exclusive conditions.
//
// Every one read-binds `NetodiaUpdater` rather than mirroring into local
// properties, so the section follows backend state without wiring.
//
// Search visibility follows `language-section.slint`: each row ANDs its state
// condition with the predicate, so a query matching the section title still
// surfaces only the rows whose state is actually true — no up-to-date message
// on a session with an update pending.
export component UpdateSection inherits Rectangle {
    background: transparent;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    in property <string> tab-name;

    property <string> card-title: @tr("Updates");

    pure function row-visible(label: string, desc: string) -> bool {
        return SettingsPage.row-visible(root.tab-name, root.card-title,
                                        label + " " + desc,
                                        SettingsPage.search-query);
    }

    property <string> software-label: @tr("Software Updates");
    property <string> software-desc: @tr("Current version: {}", NetodiaUpdater.current-version);
    property <string> up-to-date-label: @tr("You're up to date!");
    property <string> up-to-date-desc: @tr("Netodia {} is the latest version.", NetodiaUpdater.current-version);
    property <string> restart-label: @tr("Update Installed");
    property <string> restart-desc: @tr("Restart Netodia to apply the update");
    property <string> available-label: @tr("Version {} Available", NetodiaUpdater.available-version);
    property <string> managed-label: @tr("Updates managed by your package manager");
    property <string> auto-check-label: @tr("Check for updates automatically");
    property <string> auto-check-desc: @tr("Once a day, Netodia asks GitHub whether a newer version is out.");

    property <bool> show-software: row-visible(software-label, software-desc);
    // The daily task is already suppressed on a package-managed install, so the switch there would
    // describe nothing.
    property <bool> show-auto-check: !NetodiaUpdater.system-managed
        && row-visible(auto-check-label, auto-check-desc);
    property <bool> show-up-to-date:
        NetodiaUpdater.up-to-date && !NetodiaUpdater.update-available && !NetodiaUpdater.restart-needed
        && row-visible(up-to-date-label, up-to-date-desc);
    property <bool> show-restart: NetodiaUpdater.restart-needed
        && row-visible(restart-label, restart-desc);
    property <bool> show-update-available:
        NetodiaUpdater.update-available && !NetodiaUpdater.restart-needed
        && row-visible(available-label, NetodiaUpdater.notes-short);
    property <bool> show-error: NetodiaUpdater.error-message != ""
        && row-visible("", NetodiaUpdater.error-message);
    // A ternary, so each branch's literal stays inside `@tr()` and re-resolves
    // on a locale switch. The order matches `updater_settings.rs`'s values.
    property <string> pkg-manager-hint:
        NetodiaUpdater.platform-kind == "windows"
            ? @tr("Re-run the latest .msi installer from the Releases page.")
        : NetodiaUpdater.platform-kind == "macos"
            ? @tr("Use brew upgrade netodia.")
        : @tr("Use sudo dnf update netodia (or your distro equivalent).");
    property <bool> show-package-managed: NetodiaUpdater.system-managed
        && row-visible(managed-label, pkg-manager-hint);

    // Gated as a whole rather than per row: an unsupported build has no state worth a card, and
    // routing it through `has-matches` is also what keeps a search for "update" from landing on
    // an empty one.
    out property <bool> has-matches: NetodiaUpdater.updates-supported
        && (show-software || show-auto-check || show-up-to-date || show-restart
            || show-update-available || show-error || show-package-managed);

    // Wrapper so the root's preferred-height tracks the card's natural height —
    // see `language-section.slint`.
    VerticalLayout {
    if has-matches: SectionCard {
        title: root.card-title;

        if root.show-software: SettingRow {
            icon: "system_update";
            label: root.software-label;
            description: root.software-desc;
            SectionButton {
                label: NetodiaUpdater.is-checking ? @tr("Checking...") : @tr("Check for Updates");
                icon: "";
                primary: false;
                button-enabled: !NetodiaUpdater.is-checking;
                clicked => { NetodiaUpdater.check(); }
            }
        }

        // The one control for a task that otherwise runs unannounced from the first launch. The
        // welcome card discloses it too, but a setting needs a permanent home.
        if root.show-software && root.show-auto-check: SectionDivider {}
        if root.show-auto-check: SettingRow {
            icon: "update";
            label: root.auto-check-label;
            description: root.auto-check-desc;
            ToggleSwitch {
                checked <=> NetodiaUpdater.auto-check-enabled;
                toggled(v) => { NetodiaUpdater.auto-check-changed(v); }
            }
        }

        // Directly under the software row, so it's clear at once why the action
        // buttons below are missing.
        if root.show-software && root.show-package-managed: SectionDivider {}
        if root.show-package-managed: SettingRow {
            icon: "package_2";
            label: root.managed-label;
            description: pkg-manager-hint;
        }

        if root.show-software && root.show-up-to-date: SectionDivider {}
        if root.show-up-to-date: SettingRow {
            icon: "check_circle";
            label: root.up-to-date-label;
            description: root.up-to-date-desc;
        }

        if root.show-software && root.show-restart: SectionDivider {}
        if root.show-restart: SettingRow {
            icon: "restart_alt";
            label: root.restart-label;
            description: root.restart-desc;
            SectionButton {
                label: @tr("Restart Now");
                icon: "";
                primary: true;
                clicked => { NetodiaUpdater.restart(); }
            }
        }

        // Install and Skip go when the install path is package-managed: the
        // available version is still worth showing, but the action isn't ours.
        if root.show-software && root.show-update-available: SectionDivider {}
        if root.show-update-available: SettingRow {
            icon: "new_releases";
            label: root.available-label;
            description: NetodiaUpdater.notes-short;
            // The changelog arrives as one long line; capped to a reading
            // column it wraps early instead of widening the card.
            description-max-width: 480px;
            if !NetodiaUpdater.system-managed: SectionButton {
                label: NetodiaUpdater.is-installing ? @tr("Installing...") : @tr("Download & Install");
                icon: "";
                primary: true;
                button-enabled: !NetodiaUpdater.is-installing;
                clicked => { NetodiaUpdater.install(); }
            }
            if !NetodiaUpdater.system-managed && !NetodiaUpdater.is-installing
                    && !NetodiaUpdater.is-critical: SectionButton {
                label: @tr("Skip this version");
                icon: "";
                primary: false;
                clicked => { NetodiaUpdater.skip(); }
            }
        }
        // Stands in for the absent Skip button, so it's clear why this update
        // can't be dismissed permanently.
        if root.show-update-available && NetodiaUpdater.is-critical
                && !NetodiaUpdater.system-managed: SettingRow {
            icon: "shield";
            label: @tr("Critical update");
            description: @tr("This update fixes a critical issue and can't be skipped.");
        }
        if root.show-update-available && NetodiaUpdater.is-installing: Rectangle {
            background: transparent;
            VerticalLayout {
                padding-left: Theme.pad-lg;
                padding-right: Theme.pad-lg;
                padding-bottom: Theme.pad-md;
                spacing: Theme.pad-xs;

                ProgressBar {
                    value: NetodiaUpdater.download-progress / 100;
                }
                HorizontalLayout {
                    alignment: end;
                    Text {
                        text: NetodiaUpdater.download-progress + "%";
                        color: Theme.subtext0;
                        font-size: Theme.font-size-sm;
                    }
                }
            }
        }

        if (root.show-software || root.show-up-to-date || root.show-restart
                || root.show-update-available) && root.show-error: SectionDivider {}
        if root.show-error: SettingRow {
            icon: "error";
            label: "";
            description: NetodiaUpdater.error-message;
        }
    }
    }
}
