import { Favorites } from "../globals/curated.slint";
import { MosaicTabHero } from "../components/hero/mosaic-tab-hero.slint";
import { FilterThrottle } from "../components/filter-throttle.slint";
import { ViewTransition } from "../components/view-transition.slint";
import { CloudFavoritesSongsTab } from "favorites/cloud-favorites-songs-tab.slint";

// NetEase favorites are a single cloud-backed song list. Keep the shared hero styling while
// removing local-only rating, queue, artist-grid and playlist controls from this page.
export component FavoritesView inherits Rectangle {
    property <int> filter-tick-pending: 0;

    filter-throttle := FilterThrottle {
        pending: root.filter-tick-pending;
        fire() => { Favorites.filter-changed(Favorites.filter); }
    }

    TouchArea {
        clicked => { Favorites.blur-search-tick += 1; }
    }

    VerticalLayout {
        hero := MosaicTabHero {
            tab-labels: [@tr("Songs")];
            tab-icons: ["music_note"];
            tab-idx <=> Favorites.tab-idx;
            title: @tr("Favorites");
            filter-placeholder: @tr("Filter favorites…");
            show-empty-copy: false;
            empty-copy: "";
            mosaic-count: max(Favorites.track-count, 0);
            mosaic-cover: Favorites.cover;
            empty-glyph: "favorite";
            empty-glyph-filled: true;
            blur-a: Favorites.blur-img-a;
            blur-b: Favorites.blur-img-b;
            use-a: Favorites.blur-use-a;
            has-blur: Favorites.has-blur;
            filter <=> Favorites.filter;
            blur-tick: Favorites.blur-search-tick;

            search-edited(_) => { root.filter-tick-pending += 1; }
            tab-selected(i) => {
                Favorites.filter = "";
                Favorites.blur-search-tick += 1;
                Favorites.tab-changed(i);
            }
        }

        body := Rectangle {
            vertical-stretch: 1;
            clip: true;

            if Favorites.tab-idx == Favorites.tab-songs: ViewTransition {
                width: parent.width;
                height: parent.height;
                enter-from: hero.tab-enter-from;
                enabled: hero.tab-anim-armed;

                CloudFavoritesSongsTab {
                    width: 100%;
                    height: 100%;
                    rows: Favorites.tracks;
                    sort-field: Favorites.sort-field;
                    sort-dir: Favorites.sort-dir;
                    loading: Favorites.cloud-loading;
                    error: Favorites.cloud-error;
                    retry => { Favorites.retry-cloud(); }
                    play-track(id) => { Favorites.play-row(id, 0); }
                    remove-favorite(id) => { Favorites.toggle-row-favorite([id], false); }
                    request-sort(field) => { Favorites.request-sort(field); }
                }
            }
        }
    }
}
